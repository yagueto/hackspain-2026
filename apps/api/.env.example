# --- API ---
API_KEY=dev-secret            # X-API-Key para escritura y control
CORS_ORIGINS=http://localhost:3000
STORAGE_BACKEND=memory        # memory: demo efímera; postgres: persistencia duradera
DATABASE_URL=                 # obligatorio con STORAGE_BACKEND=postgres
INCIDENT_ID=incendio-gredos-demo
SEED_DEMO=true                # siembra el escenario solo si el incidente no existe
SEED_PHONES=                  # JSON rol->teléfono real, p.ej. {"firefighter":"+34600111222"} (demo con llamadas reales)
STORE_POLL_SECONDS=2
STORE_BATCH_SIZE=100
PUBLIC_BASE_URL=http://localhost:8000   # URL pública (ngrok/fly) que HappyRobot usará para el webhook

# --- HappyRobot ---
HAPPYROBOT_MODE=simulated     # live exige API key y webhook secret
HAPPYROBOT_API_KEY=           # solo para llamadas/avisos; la persistencia no lo necesita
HAPPYROBOT_CLUSTER=eu         # us | eu
HAPPYROBOT_ENVIRONMENT=development
# ids/slugs de los workflows creados en la plataforma (uno por tipo de interacción)
HAPPYROBOT_WF_CALL_RESPONDER=      # llamada a bombero/ambulancia/policía para asignar tarea
HAPPYROBOT_WF_CALL_CIVILIAN=       # aviso/evacuación a vecino
HAPPYROBOT_WF_NOTIFY_AUTHORITY=    # informe a responsable
HAPPYROBOT_WF_TELEGRAM=            # aviso de texto: el workflow hace el POST a la API de Telegram
HAPPYROBOT_WEBHOOK_SECRET=         # X-Webhook-Secret que envía el workflow al llamarnos

# --- LLM del orquestador ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=            # opcional: endpoint compatible OpenAI (p.ej. DeepSeek)
OPENAI_TIMEOUT_SECONDS=45   # el review con modelos de razonamiento tarda 8-40 s
AGENT_TICK_SECONDS=10
AGENT_AUTOSTART=false

# --- Autonomía ---
# El agente decide y despacha solo. Solo somete a confirmación humana lo crítico:
# evacuaciones masivas y avisos con vidas en peligro inmediato.
AGENT_AUTONOMOUS=true            # false = todo pasa por una persona
AGENT_HOLD_SECONDS=10            # margen para anular una decisión automática antes de enviarla
AGENT_ESCALATE_AFTER_SECONDS=30  # sin confirmar una decisión crítica, avisa una vez por Telegram

# --- Geocodificación ---
# El agente localiza por su cuenta los avisos sin GPS. El endpoint por defecto es el
# Nominatim público de OSMF, apto solo para esta demo de un único usuario: fuera de ella
# apunta a una instancia propia antes de enviarle direcciones de terceros.
GEOCODING_ENABLED=true
GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org/search
